<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_canvas">

    <LinearLayout
        android:id="@+id/main_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/app_header"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="@android:color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@color/brand_pink_soft"
                android:contentDescription="@string/cd_brand_logo"
                android:padding="3dp"
                android:src="@mipmap/ic_launcher_foreground" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_name"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="@string/brand_tagline"
                    android:textColor="@color/quiet_ink"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/header_title"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/header_language"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/surface_subtle"
                android:contentDescription="@string/cd_choose_language"
                android:padding="12dp"
                android:src="@drawable/ic_language"
                app:tint="@color/ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/header_profile"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:minWidth="0dp"
                android:contentDescription="@string/cd_open_profile"
                android:backgroundTint="@color/navy"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="?"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/screen_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="@android:color/white"
            app:backgroundTint="@android:color/white"
            app:itemActiveIndicatorStyle="@style/Widget.Mediseen.Navigation.ActiveIndicator"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/bottom_nav_colors"
            app:itemPaddingTop="8dp"
            app:itemPaddingBottom="8dp"
            app:itemTextAppearanceActive="@style/TextAppearance.Mediseen.Navigation"
            app:itemTextAppearanceInactive="@style/TextAppearance.Mediseen.Navigation"
            app:itemTextColor="@color/bottom_nav_colors"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/main_navigation" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/stage_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/assistant_fab"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="94dp"
        android:contentDescription="@string/cd_open_assistant"
        android:text=""
        android:textColor="@android:color/white"
        android:visibility="gone"
        app:backgroundTint="@color/brand_pink"
        app:icon="@drawable/ic_chat"
        app:iconPadding="0dp"
        app:iconSize="28dp"
        app:iconTint="@android:color/white" />
</FrameLayout>
