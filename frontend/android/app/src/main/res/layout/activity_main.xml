<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_canvas">

    <LinearLayout
        android:id="@+id/main_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/app_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@color/brand_pink_soft"
                android:contentDescription="@string/cd_brand_logo"
                android:padding="3dp"
                android:src="@mipmap/ic_launcher_foreground" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_name"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="@string/brand_tagline"
                    android:textColor="@color/quiet_ink"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/header_title"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/header_language"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@color/surface_subtle"
                android:contentDescription="@string/cd_choose_language"
                android:padding="11dp"
                android:src="@drawable/ic_language"
                app:tint="@color/ink" />

            <ImageButton
                android:id="@+id/header_profile"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cd_open_profile"
                android:background="@color/brand_pink_soft"
                android:padding="3dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_launcher_foreground" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/screen_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@android:color/white"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingTop="4dp"
            android:paddingEnd="3dp"
            android:paddingBottom="4dp">

            <include layout="@layout/view_nav_home" />
            <include layout="@layout/view_nav_diet" />
            <include layout="@layout/view_nav_scan" />
            <include layout="@layout/view_nav_library" />
            <include layout="@layout/view_nav_profile" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/stage_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/assistant_fab"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="78dp"
        android:contentDescription="@string/cd_open_assistant"
        android:text=""
        android:textColor="@android:color/white"
        android:visibility="gone"
        app:backgroundTint="@color/brand_pink"
        app:icon="@drawable/ic_chat"
        app:iconPadding="0dp"
        app:iconSize="28dp"
        app:iconTint="@android:color/white" />
</FrameLayout>
