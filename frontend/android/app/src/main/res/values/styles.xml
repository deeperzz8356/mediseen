<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Mediseen" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface_color</item>
        <!-- AndroidX splash attributes work across all supported API levels. -->
        <item name="windowSplashScreenBackground">@drawable/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Mediseen</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/brand_violet</item>
        <item name="colorSecondary">@color/brand_pink</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Widget.Mediseen.Panel" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Mediseen.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Mediseen.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="TextAppearance.Mediseen.Navigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.Mediseen.Nav" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Widget.Mediseen.Navigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">76dp</item>
        <item name="android:height">68dp</item>
        <item name="marginHorizontal">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Mediseen.Nav</item>
        <item name="android:color">@color/navy</item>
    </style>

    <style name="Widget.Mediseen.NavigationItem" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Mediseen.NavigationIcon" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:tint">@color/muted_ink</item>
    </style>

    <style name="Widget.Mediseen.NavigationLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
